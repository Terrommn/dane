# syntax=docker/dockerfile:1.7
# Web estática (un único build para Mini App, navegador y PWA) servida por Caddy con HTTPS automático.
FROM node:24-bookworm-slim AS build
WORKDIR /src
RUN npm i -g pnpm@12.18.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages packages
COPY apps/web apps/web
RUN pnpm install --frozen-lockfile && pnpm -C apps/web build

FROM caddy:2
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/apps/web/dist /srv/web
