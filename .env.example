# =====================================================================================================
# Dane — variables de entorno. Copia a `.env` (desarrollo) o configúralas en tu plataforma (producción).
# Nunca subas `.env` a Git. Cada servicio recibe SOLO lo que necesita (el bot NO recibe DATABASE_URL).
# Valores marcados [obligatorio] hacen fallar el arranque si faltan o son inválidos.
# =====================================================================================================

# ---------------------------------------- Servidor (apps/server) ------------------------------------
# development | test | production. En production se exige https, cookies Secure, allowlist no vacía,
# token de bot y se prohíben DEV_LOGIN_ENABLED y DEMO_ENABLED.
APP_ENV=development
# [obligatorio] PostgreSQL 17. Local sin Docker: scripts/dev-db.sh (puerto 5433).
DATABASE_URL=postgres://dane:dane@127.0.0.1:5433/dane
DATABASE_MAX_CONNECTIONS=20
# Dirección de escucha del server. En contenedores: 0.0.0.0:8080 (detrás de Caddy).
BIND_ADDR=127.0.0.1:8080
# Origen público ÚNICO de la web y la API (sin barra final). Producción: https://dane.tu-dominio.com
PUBLIC_BASE_URL=http://localhost:5180
# [obligatorio en producción] IDs numéricos de Telegram con acceso, separados por coma. Vacío = nadie puede entrar en prod.
ALLOWED_TELEGRAM_IDS=111
# false solo para desarrollo en http://localhost.
COOKIE_SECURE=false
SESSION_TTL_HOURS=720
BEARER_SESSION_TTL_HOURS=12
# Antigüedad máxima aceptada de initData de la Mini App (segundos).
MINIAPP_MAX_AGE_SECS=21600
# [obligatorio] ≥32 caracteres aleatorios; compartido SOLO con el bot. Genera: openssl rand -hex 32
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
# [obligatorio] 32 bytes en base64 para cifrar credenciales OAuth. Genera: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Token del bot (@BotFather). El server lo usa para validar initData de la Mini App.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Telegram Login (OIDC). @BotFather → tu bot → Login Widget. Redirect URI a registrar: PUBLIC_BASE_URL/api/v1/auth/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://oauth.telegram.org
# Solo desarrollo local: inicio de sesión por ID sin Telegram (respeta la allowlist). Bloqueado en producción.
DEV_LOGIN_ENABLED=true
# Datos demo opt-in aislados (solo desarrollo).
DEMO_ENABLED=true
# Google (Calendar + Gmail, solo lectura). Redirect URI: PUBLIC_BASE_URL/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Asistente de captura libre (opcional). Sin clave la app funciona en modo manual.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Tareas de fondo (recordatorios, recurrencias, sincronizaciones, procesamiento de updates).
SCHEDULER_ENABLED=true
# Opcional: servir la web compilada desde el server (en producción la sirve Caddy).
WEB_DIST_DIR=
# json en producción.
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
IMPORT_MAX_BYTES=52428800

# ---------------------------------------- Bot (apps/telegram-bot) -----------------------------------
# El bot recibe: TELEGRAM_BOT_TOKEN, INTERNAL_API_TOKEN, SERVER_INTERNAL_URL y las de modo. Nada de base de datos.
SERVER_INTERNAL_URL=http://127.0.0.1:8080
# polling (desarrollo) | webhook (producción). Nunca ambos: el bot borra/configura el webhook según el modo.
TELEGRAM_MODE=polling
# Solo webhook: URL pública que Telegram llamará (Caddy la enruta al bot) y secreto (1–256 chars [A-Za-z0-9_-]).
WEBHOOK_PUBLIC_URL=
WEBHOOK_SECRET=
BOT_BIND_ADDR=127.0.0.1:8081

# ---------------------------------------- Producción (infra/compose.prod.yml) -----------------------
# Dominio para HTTPS automático de Caddy y correo para Let's Encrypt.
DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
